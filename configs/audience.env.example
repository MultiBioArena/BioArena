# Load into the environment of scripts/serve_audience.sh; never commit a provider key.
BIO_AUDIENCE_DB=.private/audience/arena.sqlite3
BIO_AUDIENCE_SOURCE=http://127.0.0.1:8140/api/state
BIO_AUDIENCE_PORT=8143
BIO_AUDIENCE_HOST=127.0.0.1
# disabled | paper_test (address only, no rewards) | token_holder (read-only ERC-20 check)
BIO_VOTE_MODE=disabled
# Set the actual launch network; EVM address syntax does not identify a chain.
BIO_VOTE_CHAIN_ID=0
BIO_VOTE_TOKEN=
BIO_VOTE_RPC_URL=
# Minimum in raw token units. 1 means any non-zero balance, not one whole token.
BIO_VOTE_MINIMUM_RAW=1
BIO_VOTE_CONFIRMATIONS=3
